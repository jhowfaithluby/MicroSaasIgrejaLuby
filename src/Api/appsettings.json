{
  "ConnectionStrings": {
    "Default": "Data Source=microsaasigreja.db"
  },
  "Database": {
    "Provider": "Sqlite"
  },
  "Frontend": {
    "Origins": [
      "http://localhost:5173"
    ]
  },
  "Jwt": {
    "Issuer": "MicroSaasIgreja",
    "Audience": "MicroSaasIgrejaFront",
    "SigningKey": "CHANGE-ME-TO-A-VERY-LONG-SECRET-KEY",
    "AccessTokenLifetimeMinutes": 60,
    "RefreshTokenLifetimeDays": 7
  },
  "Seed": {
    "Admin": {
      "Email": "admin@microsaasigreja.local",
      "FullName": "Administrador",
      "Password": "Admin@12345",
      "Roles": [
        "Administrator"
      ]
    }
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information"
      }
    }
  }
}
